{
  "name": "ecommerce-modular-monolith",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "start:server": "npm --workspace=server run start",
    "dev:server": "npm --workspace=server run dev",
    "dev:client": "npm --workspace=client run dev",
    "dev": "npm --workspace=server run dev",
    "build": "npm --workspace=client run build",
    "migrate": "npm --workspace=server run migrate",
    "seed": "npm --workspace=server run seed",
    "test": "npm --workspace=server run test && npm --workspace=client run test",
    "test:unit": "npm --workspace=server run test:unit",
    "test:integration": "npm --workspace=server run test:integration"
  }
}

